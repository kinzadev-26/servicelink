                ]
              }
            }
          ]
        },
        {
          "name": "Filter by city",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/providers?city=Karachi&minRating=4.5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "providers"
              ],
              "query": [
                {
                  "key": "city",
                  "value": "Karachi"
                },
                {
                  "key": "minRating",
