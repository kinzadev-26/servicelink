            "url": {
              "raw": "{{baseUrl}}/services",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "services"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider\": \"{{providerId}}\",\n  \"category\": \"{{categoryId}}\",\n  \"title\": \"Pipe replacement\",\n  \"description\": \"Replace old pipes\",\n  \"price\": 2200,\n  \"durationMinutes\": 60\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('newServiceId', pm.response.json().data._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create service: invalid (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
